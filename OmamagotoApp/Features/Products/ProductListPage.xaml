<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OmamagotoApp.Features.Products.ProductListPage"
             xmlns:models="clr-namespace:OmamagotoApp.Features.Products.Models"
             x:DataType="models:Product"
             Title="一覧">

<CollectionView ItemsSource="{Binding Products}">
    <CollectionView.ItemTemplate>
        <DataTemplate
            x:DataType="models:Product">

            <Grid
                Padding="12"
                ColumnDefinitions="*,Auto">

                <Label
                    Text="{Binding Name}" />

                <Label
                    Grid.Column="1"
                    Text="{Binding Price,
                        StringFormat='{0:N0}円'}" />

            </Grid>
        </DataTemplate>
    </CollectionView.ItemTemplate>
</CollectionView>

</ContentPage>
